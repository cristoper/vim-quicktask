Execute (BufferToAST):
  edit ./test/test.qt
  " opens buffer in new split window
  call quicktask#export#BufferToAST()
  let actual = getline(1, '$')
  let expected = readfile('./test/expected_ast.txt')
  AssertEqual expected, actual

Execute (QTTimeSheet):
  edit ./test/test.qt
  " opens buffer in new split window
  call quicktask#export#BufferToCSV()
  let actual = getline(1, '$')
  let expected = readfile('./test/expected_csv.csv')
  AssertEqual expected, actual

